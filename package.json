{
  "name": "dev-web-server",
  "version": "3.0.0",
  "description": "A simple web & API server for your development: static files, mocked API endpoints, SPA, CORS.",
  "author": "Emmanuel Fitoussi",
  "license": "MIT",
  "homepage": "https://github.com/manufitoussi/dev-web-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manufitoussi/dev-web-server.git"
  },
  "bugs": {
    "url": "https://github.com/manufitoussi/dev-web-server/issues"
  },
  "type": "module",
  "main": "./web-server/app.js",
  "bin": {
    "dev-web-server": "web-server/app.js"
  },
  "files": [
    "web-server",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node ./web-server/app.js BASEDIR ./demo/public ENDPOINTS ./demo/endpoints.js",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "mime-types": "^2.1.35"
  },
  "keywords": [
    "server",
    "webserver",
    "web-server",
    "http",
    "http-server",
    "httpserver",
    "endpoint",
    "API",
    "mock",
    "web",
    "SPA",
    "CORS",
    "routing",
    "lightweight",
    "mock-server",
    "api-mock",
    "dev-server",
    "static-server"
  ]
}
